{
  "name": "ki-enzyklopaedie",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "KI-Enzyklopädie — reine Lese-App: quellenbelegte, quervernetzte Artikel zu KI-Consulting, EU AI Act, Governance und KI-Ethik.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "inhalt:export": "tsx scripts/export-aus-akademie.mts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "node scripts/gen-icon.mjs && tauri icon src-tauri/icon-src.png && node -e \"for (const d of ['src-tauri/icons/android','src-tauri/icons/ios']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "tauri:installer-bild": "node scripts/gen-installer-bild.mjs",
    "nativ:beweis": "node scripts/nativ-beweis.mjs",
    "os:beweis": "node scripts/os-beweis.mjs",
    "weitergabe": "node scripts/weitergabe.mjs",
    "installer:beweis": "pwsh -NoProfile -File scripts/installer-beweis.ps1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
